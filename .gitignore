# Bytecode: regenerated at every run, machine-specific.
__pycache__/
*.py[cod]
.pytest_cache/

# Output of `python <source>/tools/trial_install.py`: regenerated, not versioned.
_build/

# Working material: stays on the machine, not in the published package.
# UPDATE.md is the decision log, docs/ the plans and evaluations,
# sources/ the archive of the projects the method was distilled from.
UPDATE.md
UPGRADE.md
docs/
sources/
scripts/
dictionary.txt

# The framework installed on this repository itself: generated from
# claude-framework-it, regenerated by the installer, not part of the
# published package.
/.claude/
/CLAUDE.md
